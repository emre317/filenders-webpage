{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Filenders Lojistik ve Teknoloji — kurumsal tasarım sistemi. Source of truth for client/src/styles/tokens.css.",
  "primitive": {
    "color": {
      "slate": {
        "50": { "$value": "#F4F7F9", "$type": "color" },
        "200": { "$value": "#D7E0E6", "$type": "color" },
        "400": { "$value": "#7C8B98", "$type": "color" },
        "600": { "$value": "#45525E", "$type": "color" }
      },
      "teal": {
        "300": { "$value": "#7CE6EE", "$type": "color", "$description": "Accent — vurgu metinleri, ikincil parlaklık" },
        "400": { "$value": "#3DD3DF", "$type": "color", "$description": "Primary hover" },
        "450": { "$value": "#1AC4D1", "$type": "color", "$description": "Brand primary — Filenders'ın imza rengi" },
        "500": { "$value": "#16B8C4", "$type": "color" },
        "600": { "$value": "#0E939D", "$type": "color" },
        "700": { "$value": "#0B6E76", "$type": "color" }
      },
      "emerald": {
        "500": { "$value": "#10B981", "$type": "color", "$description": "Rezerve — başarı durumları (form/uyarı bileşenleri için)" },
        "600": { "$value": "#059669", "$type": "color" }
      },
      "amber": {
        "500": { "$value": "#F59E0B", "$type": "color", "$description": "Rezerve — uyarı durumları" }
      },
      "red": {
        "500": { "$value": "#EF4444", "$type": "color", "$description": "Rezerve — hata/tehlike durumları" },
        "600": { "$value": "#DC2626", "$type": "color" }
      },
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "black": { "$value": "#000000", "$type": "color" }
    },
    "spacing": {
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "5": { "$value": "1.25rem", "$type": "dimension" },
      "6": { "$value": "1.5rem", "$type": "dimension" },
      "8": { "$value": "2rem", "$type": "dimension" },
      "10": { "$value": "2.5rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" },
      "16": { "$value": "4rem", "$type": "dimension" },
      "20": { "$value": "5rem", "$type": "dimension" },
      "24": { "$value": "6rem", "$type": "dimension" },
      "32": { "$value": "8rem", "$type": "dimension" }
    },
    "fontFamily": {
      "sans": { "$value": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'JetBrains Mono', ui-monospace, 'SFMono-Regular', Consolas, monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.25rem", "$type": "dimension" },
      "2xl": { "$value": "1.5rem", "$type": "dimension" },
      "3xl": { "$value": "1.875rem", "$type": "dimension" },
      "4xl": { "$value": "2.25rem", "$type": "dimension" },
      "5xl": { "$value": "3rem", "$type": "dimension" },
      "6xl": { "$value": "3.75rem", "$type": "dimension" },
      "7xl": { "$value": "4.5rem", "$type": "dimension" }
    },
    "radius": {
      "sm": { "$value": "0.375rem", "$type": "dimension" },
      "default": { "$value": "0.5rem", "$type": "dimension" },
      "md": { "$value": "0.75rem", "$type": "dimension" },
      "lg": { "$value": "1.25rem", "$type": "dimension" },
      "xl": { "$value": "1.75rem", "$type": "dimension" },
      "2xl": { "$value": "2.25rem", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "shadow": {
      "sm": { "$value": "0 1px 2px 0 rgb(0 0 0 / 0.24)", "$type": "shadow" },
      "default": { "$value": "0 1px 3px 0 rgb(0 0 0 / 0.3), 0 1px 2px -1px rgb(0 0 0 / 0.3)", "$type": "shadow" },
      "md": { "$value": "0 8px 20px -4px rgb(0 0 0 / 0.35)", "$type": "shadow" },
      "lg": { "$value": "0 20px 40px -12px rgb(0 0 0 / 0.45)", "$type": "shadow" },
      "xl": { "$value": "0 32px 64px -16px rgb(0 0 0 / 0.55)", "$type": "shadow" },
      "glow": { "$value": "0 0 0 1px rgb(22 184 196 / 0.25), 0 12px 40px -8px rgb(22 184 196 / 0.45)", "$type": "shadow" }
    },
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "280ms", "$type": "duration" },
      "slow": { "$value": "550ms", "$type": "duration" }
    },
    "ease": {
      "out": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier" }
    }
  },
  "semantic": {
    "color": {
      "background": { "$value": "#070B10", "$type": "color", "$description": "En derin zemin — bespoke gece tonu, ölçekte tekrar kullanılmaz" },
      "background-subtle": { "$value": "#0B1117", "$type": "color" },
      "foreground": { "$value": "#F2F6F8", "$type": "color" },
      "foreground-muted": { "$value": "#90A0AC", "$type": "color" },
      "primary": { "$value": "{primitive.color.teal.450}", "$type": "color" },
      "primary-hover": { "$value": "{primitive.color.teal.400}", "$type": "color" },
      "primary-foreground": { "$value": "#04141A", "$type": "color" },
      "primary-subtle": { "$value": "rgb(26 196 209 / 0.12)", "$type": "color", "$description": "primary %12 opaklık" },
      "accent": { "$value": "{primitive.color.teal.300}", "$type": "color" },
      "secondary": { "$value": "#101820", "$type": "color" },
      "secondary-foreground": { "$value": "#F2F6F8", "$type": "color" },
      "muted": { "$value": "#0D141B", "$type": "color" },
      "muted-foreground": { "$value": "{primitive.color.slate.400}", "$type": "color" },
      "border": { "$value": "#1B2530", "$type": "color" },
      "border-strong": { "$value": "#29394A", "$type": "color" },
      "ring": { "$value": "{primitive.color.teal.450}", "$type": "color" },
      "success": { "$value": "{primitive.color.emerald.500}", "$type": "color" },
      "success-subtle": { "$value": "rgb(16 185 129 / 0.12)", "$type": "color" },
      "warning": { "$value": "{primitive.color.amber.500}", "$type": "color" },
      "danger": { "$value": "{primitive.color.red.500}", "$type": "color" },
      "surface": { "$value": "#0D141C", "$type": "color" },
      "surface-2": { "$value": "#121B24", "$type": "color" },
      "surface-inverted": { "$value": "#F2F6F8", "$type": "color" },
      "foreground-inverted": { "$value": "#070B10", "$type": "color" }
    },
    "spacing": {
      "component": { "$value": "{primitive.spacing.4}", "$type": "dimension" },
      "section-y": { "$value": "7rem", "$type": "dimension" },
      "section-y-sm": { "$value": "3.5rem", "$type": "dimension" }
    }
  },
  "component": {
    "button-primary": {
      "bg": { "$value": "{semantic.color.primary}", "$type": "color" },
      "fg": { "$value": "{semantic.color.primary-foreground}", "$type": "color" },
      "hover-bg": { "$value": "{semantic.color.primary-hover}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.full}", "$type": "dimension" },
      "padding-x": { "$value": "1.75rem", "$type": "dimension" },
      "padding-y": { "$value": "0.85rem", "$type": "dimension" },
      "shadow": { "$value": "0 12px 32px -8px rgb(26 196 209 / 0.55)", "$type": "shadow" }
    },
    "button-secondary": {
      "bg": { "$value": "transparent", "$type": "color" },
      "fg": { "$value": "{semantic.color.foreground}", "$type": "color" },
      "border": { "$value": "{semantic.color.border-strong}", "$type": "color" },
      "hover-bg": { "$value": "{semantic.color.surface-2}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.full}", "$type": "dimension" },
      "padding-x": { "$value": "1.75rem", "$type": "dimension" },
      "padding-y": { "$value": "0.85rem", "$type": "dimension" }
    },
    "card": {
      "bg": { "$value": "{semantic.color.surface}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "shadow": { "$value": "0 1px 3px 0 rgb(0 0 0 / 0.3)", "$type": "shadow" },
      "shadow-hover": { "$value": "0 20px 40px -12px rgb(0 0 0 / 0.5)", "$type": "shadow" },
      "padding": { "$value": "2.5rem", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.xl}", "$type": "dimension" }
    },
    "badge": {
      "bg": { "$value": "{semantic.color.primary-subtle}", "$type": "color" },
      "fg": { "$value": "{semantic.color.accent}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.full}", "$type": "dimension" },
      "padding-x": { "$value": "0.875rem", "$type": "dimension" },
      "padding-y": { "$value": "0.375rem", "$type": "dimension" }
    },
    "nav": {
      "bg": { "$value": "rgb(7 11 16 / 0.72)", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" }
    }
  }
}
